@echo off
REM Universal Build Script for Chess Application (Windows)
REM Builds installers for Windows platform

setlocal enabledelayedexpansion

echo.
echo ????????????????????????????????????????????????????????????
echo ?         Chess Application - Windows Builder              ?
echo ?                                                          ?
echo ?  Builds installers for Windows (MSI)                    ?
echo ?                                                          ?
echo ?  Requirements:                                           ?
echo ?    - WiX Toolset 3.14+                                  ?
echo ?    - .NET 8 SDK                                         ?
echo ????????????????????????????????????????????????????????????
echo.

set VERSION=1.0.0
set PUBLISH_DIR=publish
set BUILD_DIR=build

REM Step 1: Publish application
echo [1/4] Publishing application...
if not exist "%PUBLISH_DIR%" (
    dotnet publish Chess/Chess.csproj -c Release -o %PUBLISH_DIR% --self-contained false
) else (
    echo ? Already published
)

REM Step 2: Check WiX installation
echo.
echo [2/4] Checking WiX Toolset...
set WIX_DIR=%ProgramFiles%\WiX Toolset v3.14
if not exist "%WIX_DIR%" (
    echo ??  WiX Toolset not found!
    echo Please download and install from: https://github.com/wixtoolset/wix3/releases
    pause
    exit /b 1
)
echo ? WiX Toolset found

REM Step 3: Build MSI
echo.
echo [3/4] Building Windows MSI installer...
cd installer
call build-windows-msi.bat
cd ..

REM Step 4: Generate checksums
echo.
echo [4/4] Generating checksums...
if exist "Chess-%VERSION%.msi" (
    certutil -hashfile "Chess-%VERSION%.msi" SHA256 > "Chess-%VERSION%.msi.sha256"
    echo ? Checksum created
)

REM Summary
echo.
echo ???????????????????????????????????????????????????????
echo Build Complete!
echo ???????????????????????????????????????????????????????
echo.
echo ?? Installer created: Chess-%VERSION%.msi
if exist "Chess-%VERSION%.msi" (
    for %%A in ("Chess-%VERSION%.msi") do (
        echo ?? Size: %%~zA bytes
    )
)
echo.
echo ?? Checksum: Chess-%VERSION%.msi.sha256
echo.
echo Next steps:
echo   1. Test the MSI on a clean Windows system
echo   2. Upload to GitHub Releases
echo   3. Update documentation
echo.
pause
